{
  "name": "baret",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A transaction firewall for Monad. Simulates, checks and explains every transaction before it is signed.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:showcase": "pnpm --filter @baret/showcase dev",
    "dev:wallet": "pnpm --filter @baret/wallet dev",
    "dev:extension": "pnpm --filter @baret/extension dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "typecheck:watch": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:copy": "pnpm --filter @baret/content lint:copy",
    "check": "pnpm lint && pnpm typecheck && pnpm lint:copy && pnpm test",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist **/*.tsbuildinfo"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
