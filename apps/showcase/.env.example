# Showcase build-time settings. Copy to .env.local; never commit real values.

# A developer's stand-in for a wallet on all six demo sites: a funded Monad
# testnet address the live checks simulate from (no key needed, nothing is
# signed). A connected wallet always wins. Leave empty and a site with no
# wallet shows its prepared sample and never calls the API.
VITE_BARET_DEMO_FROM=

# The extension builds for /install, once a zip is published (an https URL,
# for example a GitHub release asset). Leave empty and the page says no build
# is published yet and points at the source.
VITE_BARET_EXTENSION_CHROMIUM_URL=
VITE_BARET_EXTENSION_FIREFOX_URL=

# The extension's store listings, once each is public: its page in the Chrome
# Web Store (https://chromewebstore.google.com/detail/...) and on Firefox
# Add-ons. With one set, /install sends that browser's visitors to the store
# instead of the zip: no developer mode, nothing to extract, and that build's
# zip is no longer offered. Each is read on its own, so Chrome can be listed
# while Firefox still gets the zip. Leave empty until the listing is public.
VITE_BARET_EXTENSION_CHROMIUM_STORE_URL=
VITE_BARET_EXTENSION_FIREFOX_STORE_URL=

# The /agents playground. "live" sends the eight actions and a pasted
# transaction to /v1/analyze with the picked policy; leave empty and it
# answers from prepared samples and sends nothing.
VITE_BARET_PLAYGROUND=
# The wallet the six non-Cleanverse live actions sign from: a Monad testnet
# address kept funded with MON, real test USDC and the demo fake USDC. The
# two Cleanverse actions sign from Cleanverse's verified holder and use this
# wallet only as the recipient with no credential. Read at build time.
# Leave empty and all eight actions answer from prepared samples even when
# VITE_BARET_PLAYGROUND is "live"; only a pasted transaction is sent.
VITE_BARET_PLAYGROUND_AGENT=

# The Baret wallet the demo sites open in its own window ("Check with Baret",
# and the Baret row of the wallet picker). Leave empty for the deployed wallet
# at https://wallet.usebaret.com; set it to a local wallet's URL (for
# example http://localhost:5174) to try both apps on one machine.
VITE_BARET_WALLET_URL=

# Deploy-time settings, read by the build and the edge, not by client code
# (they carry no VITE_ prefix on purpose). Set them in the Vercel project,
# not in a committed file.
# The site's public URL. scripts/head.mjs writes the canonical URL, og:url,
# an absolute og:image and sitemap.xml from it; a Vercel production build
# falls back to VERCEL_PROJECT_PRODUCTION_URL. Without either a build prints
# a warning and ships no sitemap ("Do not deploy it").
# BARET_SITE_URL=https://usebaret.com
# Set to 1 to turn the missing-site-URL warning into a build error (what a
# Vercel production build does by itself).
# BARET_REQUIRE_SITE_URL=1
# A shared secret the edge (middleware.ts) sends on to the API as x-baret-edge
# so the API can trust x-baret-client for the per-visitor limit. Vercel
# dashboard only; the same value is BARET_EDGE_SECRET on the API.
# BARET_EDGE_SECRET=
# Set to 1 to build hidden source maps for an error tracker that uploads and
# deletes them (none is wired). Off by default: a security product does not
# publish its source (E4).
# BARET_SOURCEMAPS=
