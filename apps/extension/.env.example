# Extension build-time settings. Copy to .env.local; never commit real values.

# Where the manifest's host_permissions points, and (once the extension reads
# live data) where it fetches from. Read at build time, so it is fixed into
# the package, not changed at runtime. Leave empty for the local server,
# http://localhost:8080; set it to https://baret-monad-api.onrender.com for a
# build meant for the store or a judge.
WXT_BARET_API_URL=

# The Monad node the wallet reads balances from and sends transactions
# through. Fixed into the build and added to the manifest's host_permissions.
# Leave empty for the public testnet node, https://testnet-rpc.monad.xyz.
WXT_MONAD_TESTNET_RPC_URL=
