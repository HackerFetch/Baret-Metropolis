# Wallet build-time settings. Copy to .env.local; never commit real values.

# A deployed build always runs the live wallet: a passkey, a real account on
# Monad testnet and Baret's check through /api. In dev the wallet shows its
# prepared samples; set this to "live" to run the live wallet locally too.
# A ?sample= in the URL keeps the samples either way.
VITE_BARET_WALLET=

# The Monad node the wallet reads from and sends transactions through. Read
# at build time. Leave empty for the public testnet node,
# https://testnet-rpc.monad.xyz.
VITE_MONAD_TESTNET_RPC_URL=

# Not set here: BARET_EDGE_SECRET is a Vercel project setting that
# middleware.ts reads on the deployed site (docs/DEPLOYMENT.md).
