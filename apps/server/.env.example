# Copy to .env and fill in. Never commit .env.

PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Monad testnet (chain 10143). Every read goes here, batched (Alchemy).
MONAD_TESTNET_RPC_URL=
# Optional: a node for debug_traceCall when the main RPC has none (Alchemy free tier).
# The public https://testnet-rpc.monad.xyz traces.
MONAD_TESTNET_TRACE_RPC_URL=
# Canonical USDC on Monad testnet. Verify on the explorer before setting.
MONAD_TESTNET_USDC_ADDRESS=
# contracts/src/ReputationRegistry.sol, after deploy (docs/CONTRACTS.md §3.4).
MONAD_TESTNET_REPUTATION_REGISTRY_ADDRESS=
# Comma-separated contracts Baret vouches for (PaymentGuard, showcase contracts).
MONAD_TESTNET_KNOWN_CONTRACTS=
# contracts/src/PaymentGuardFactory.sol: its vaults count as known contracts.
MONAD_TESTNET_PAYMENT_GUARD_FACTORY_ADDRESS=

# Monad mainnet (chain 143). Optional: the mainnet network is served only when set.
MONAD_MAINNET_RPC_URL=
MONAD_MAINNET_TRACE_RPC_URL=
MONAD_MAINNET_USDC_ADDRESS=
MONAD_MAINNET_REPUTATION_REGISTRY_ADDRESS=
MONAD_MAINNET_KNOWN_CONTRACTS=

# Comma-separated API keys for /v1. Empty = open (development only).
BARET_API_KEYS=
# Comma-separated allowed origins. Empty = any origin.
BARET_CORS_ORIGINS=
BARET_RATE_LIMIT_PER_MINUTE=120
BARET_REQUEST_TIMEOUT_MS=8000
# How long a verdict stays valid before the client must ask again.
BARET_VERDICT_TTL_SECONDS=30

# The deployed Envio indexer's GraphQL endpoint (indexer/). Unset: /v1/audit answers 503.
ENVIO_ENDPOINT=

# Sponsor integrations. Missing keys make the rules that need them fail closed.
NANSEN_API_KEY=
# funder (default): first-funder lookups, 1 credit per wallet, fits the free plan.
# labels: Profiler labels, 100 credits per wallet, needs a paid plan or granted credits.
NANSEN_MODE=funder
# Cleanverse's A-Pass (identity) and aToken policy contracts. Both or neither.
# Unset: identity rules fail closed and compliant assets are not recognised.
MONAD_TESTNET_CLEANVERSE_APASS_ADDRESS=0xbA82D189540CaC9DC6FF46B6837CaC1BFdEC58B9
MONAD_TESTNET_CLEANVERSE_POLICY_ADDRESS=0x36489bE45fa84f70a0c2BDB11D824Be608CB12Dd

# KIMI (Moonshot) writes the plain-language explanations of POST /v1/explain.
# Without the key that route answers 503. Base URL and model have defaults
# (https://api.moonshot.ai/v1, kimi-k3).
KIMI_API_KEY=
# KIMI_BASE_URL=
# KIMI_MODEL=
