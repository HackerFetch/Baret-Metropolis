{
  "name": "@baret/agent-kit",
  "version": "0.1.1",
  "description": "A guarded wallet for AI agents on Monad: every transaction is checked by Baret before it is signed.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HackerFetch/Baret-Metropolis.git",
    "directory": "packages/agent-kit"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./reviewer": "./src/reviewer.ts",
    "./review-agent": "./src/review-agent.ts",
    "./abi": "./src/abi.ts"
  },
  "bin": {
    "baret": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "baret": "tsx --env-file-if-exists=.env src/cli.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/bin.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@baret/guard": "workspace:*",
    "@baret/llm": "workspace:*",
    "viem": "2.56.5",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@dynamic-labs-wallet/node-evm": "1.1.28"
  },
  "peerDependenciesMeta": {
    "@dynamic-labs-wallet/node-evm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dynamic-labs-wallet/node-evm": "1.1.28",
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./reviewer": {
        "types": "./dist/reviewer.d.ts",
        "default": "./dist/reviewer.js"
      },
      "./review-agent": {
        "types": "./dist/review-agent.d.ts",
        "default": "./dist/review-agent.js"
      },
      "./abi": {
        "types": "./dist/abi.d.ts",
        "default": "./dist/abi.js"
      }
    },
    "bin": {
      "baret": "./dist/cli.js"
    }
  }
}
