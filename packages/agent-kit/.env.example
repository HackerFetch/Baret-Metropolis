# @baret/agent-kit CLI settings (packages/agent-kit/src/cli.ts). Copy to
# .env in this folder; the monorepo scripts load it, "npx baret" from npm
# reads the shell environment only. Never commit real values.

# The Baret API the agent asks before it signs. Default: the live API.
BARET_API_URL=https://baret-monad-api.onrender.com
# An API key, if the API requires one (sent as x-baret-key). Optional.
BARET_API_KEY=
# "testnet" (default) or "mainnet".
BARET_NETWORK=testnet
# The Monad node the agent sends through. Default: the public node of the
# chosen network.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC_URL=
# Policy template the checks run under: strict, balanced (default) or
# permissive.
BARET_POLICY_TEMPLATE=balanced
# Set to 1 to let the agent sign a Caution verdict (D-022). Off by default:
# an agent signs only on Safe.
BARET_ALLOW_CAUTION=

# The signer, one of the two:
# (a) a key held in memory (a testnet agent key, never the deploy key).
BARET_AGENT_PRIVATE_KEY=
# (b) a Dynamic server wallet (MPC): the environment id and an auth token
# from the Dynamic dashboard, and the password of the local wallet file.
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_AUTH_TOKEN=
BARET_AGENT_WALLET_PASSWORD=
# Where "baret wallet create" keeps the Dynamic wallet file.
# Default: ~/.baret/agent-wallet.json
BARET_AGENT_WALLET_FILE=

# "baret review" (the Qwen adversarial reviewer). Without QWEN_API_KEY the
# command says it is not configured.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
