{
  "name": "@baret/web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The web signature layer shared by the showcase and the wallet: type scale, layout frame, motion, reveals, parallax, smooth scroll, the eyelet cursor, the fonts and the verdict blocks. Consumed as TypeScript source, never built.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./styles/*": "./src/styles/*",
    "./vite": {
      "types": "./vite.d.mts",
      "default": "./vite.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@baret/content": "workspace:*",
    "@baret/ui": "workspace:*",
    "lenis": "1.3.26",
    "lucide-react": "1.46.0",
    "motion": "13.3.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
