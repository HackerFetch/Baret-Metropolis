# Foundry script settings for contracts/script/*.s.sol. Copy to .env in this
# folder and "source .env" before "forge script"; the deploy key itself is
# passed with --private-key or a keystore, never from a file in the repo.
# Addresses are Monad testnet (10143) unless noted. Never commit real values.

MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Deploy.s.sol (PaymentGuard + ReputationRegistry + ReputationOracleReceiver)
BARET_OWNER=
MONAD_TESTNET_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
MONAD_MAINNET_USDC_ADDRESS=
# The Chainlink CRE forwarder the receiver accepts reports from.
BARET_CRE_FORWARDER=

# DeployReputationOracleReceiver.s.sol
REGISTRY=0x7491Cb218A7b184ac50F9c2bfbd54C2a67Bfa411
BARET_CRE_WORKFLOW_OWNER=
# Comma-separated addresses a poisoned feed may never flag (optional).
BARET_PROTECTED=

# DeployCompliantPaymentGuard.s.sol (defaults: Cleanverse's aUSDC, A-Pass
# and policy on testnet, minimum tier 1; set BARET_CVA for another asset,
# for example BVUSD 0xCd829D44Dced8B47Ab0E4B08F1527cD2734E8ed2).
BARET_CVA=
BARET_APASS=
BARET_CVA_POLICY=
BARET_MIN_TIER=

# DeployNovaSwap.s.sol / DeployNovaSwapDrainer.s.sol / DeployDemoSites.s.sol
# (showcase demo contracts). DRAINER_SALT is a bytes32 for CREATE2 so the
# look-alike address resembles the router's.
ROUTER_FUNDING_WEI=
DEMO_USDC=
DRAINER_SINK=
DRAINER_SALT=

# Tests: set to 1 to run the Cleanverse fork test against the real chain
# (needs MONAD_TESTNET_RPC_URL). Skipped otherwise.
BARET_FORK_CLEANVERSE=
